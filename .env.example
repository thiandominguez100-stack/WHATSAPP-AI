# WA-Bridge AI — configuración local para Windows
HOST=127.0.0.1
PORT=5000
WA_BRIDGE_DB=data/wa_bridge.db

# Ollama local (usa el modelo que ya tienes descargado).
# Ollama debe estar ejecutándose en Windows.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen2.5:1.5b
AI_API_KEY=ollama

# En futuras versiones multiusuario: genera una clave larga y privada.
# No publiques .env ni compartas esta clave.
SESSION_SECRET=change-this-local-secret-before-deployment
